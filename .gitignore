# ===== 通用构建产物 =====
obj_dir/
build/
prj_tasks/
*.log
*.sbit
.dide/

# ===== Pango PDS 输出 =====
**/fpga/prj_pds/compile/
**/fpga/prj_pds/synthesize/
**/fpga/prj_pds/device_map/
