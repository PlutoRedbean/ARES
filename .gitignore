# guard 板级 PDS 流程（在 guard/ 根目录落地）
guard/*.pds
guard/impl.tcl
guard/fpga/pango/*_run.tcl
guard/fpga/pango/configuration_tcl.log
guard/fpga/pango/log/
guard/generate_bitstream/
guard/logbackup/
guard/prj_tasks/
guard/log/

