# ---- build / sim artifacts ----
obj_dir/
build/
prj_tasks/
*.log

# ---- PDS outputs (paths are relative to the project root, any depth) ----
**/fpga/prj_pds/compile/
**/fpga/prj_pds/synthesize/
**/fpga/prj_pds/device_map/
**/fpga/prj_pds/place_route/
**/fpga/prj_pds/report_timing/
**/fpga/prj_pds/report_power/
**/fpga/prj_pds/generate_bitstream/
**/fpga/prj_pds/build/
**/fpga/prj_pds/build_rv.pds
**/fpga/prj_pds/impl.tcl
**/cam/fpga/pango/*.pds
**/cam/fpga/pango/impl.tcl
**/tools/smoke/*.pds
**/tools/smoke/impl.tcl

# ---- guard 板级 PDS 流程（落在 guard/ 根目录） ----
guard/*.pds
guard/impl.tcl
# cdt_cfg 运行时生成的展开副本 / 它自己的日志（可随手删）
guard/fpga/pango/*_run.tcl
guard/fpga/pango/configuration_tcl.log
guard/fpga/pango/log/
guard/generate_bitstream/
guard/logbackup/

# local PnR outputs (not committed)
**/bitstreams/*.sbit

# ---- python ----
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- editors / os ----
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store
*.swp
*.bak

# ---- local env / data (huge, kept outside git) ----
**/.venv/
**/pcvision/data/
# training workspace must stay outside the repo; ignore it if someone drops it in
gesture-env/

# future RV build
**/fpga/rtl_rv/fw/out/

# ---- guard (PII gateway) ----
# 模型权重 / 量化产物不入库：放仓库外，或放在 models/（下面这行忽略）
guard/models/
# guard 板级 PDS 流程在 guard/ 根目录留下的中间产物
guard/prj_tasks/
guard/generate_bitstream/
guard/log/
guard/logbackup/
guard/*.pds
guard/impl.tcl