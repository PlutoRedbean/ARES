# ---- 通用构建产物 ----
obj_dir/
build/
prj_tasks/
*.log

# ---- Pango PDS 输出（任意深度的项目目录） ----
**/fpga/prj_pds/compile/
**/fpga/prj_pds/synthesize/
**/fpga/prj_pds/device_map/
**/fpga/prj_pds/place_route/
**/fpga/prj_pds/report_timing/
**/fpga/prj_pds/report_power/
**/fpga/prj_pds/generate_bitstream/
**/fpga/prj_pds/build/

# guard 板级 PDS 流程（在 guard/ 根目录落地）
guard/*.pds
guard/impl.tcl
guard/fpga/pango/*_run.tcl
guard/fpga/pango/configuration_tcl.log
guard/fpga/pango/log/
guard/generate_bitstream/
guard/logbackup/
guard/prj_tasks/
guard/log/

# 本地 PnR 位流不入库
**/bitstreams/*.sbit

# ---- python ----
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
**/.venv/

# ---- Pango PDS/IDE 解析缓存（每次跑 PDS 会重新生成） ----
.dide/

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store
*.swp
*.bak

# ---- guard：模型权重与量化产物不入库 ----
guard/models/
