# ---------------------------------------------------------------------------
# PDS flow -- guard board: UART in -> L1 redaction -> UART out
#                (top module guard_board_top)
#
# Device: Pangu 200Pro+ / PG2L200H-6IFBB676
# Tool:   PDS 2025.2-SP3 (synthesize -ads); PDS 2022.2 uses -system_verilog
#
# Usage (Windows, from the repo root or from guard/):
#   D:\Pango\PDS_2025.2-SP3-EN-ads\bin\pds_shell.exe ^
#       -file guard\fpga\pango\flow_guard.tcl -project_name guard_board
#
# Prerequisite: build/gen/l1_keywords_pkg.sv (generated by
#   tools/gen_keywords.py; tools/build_guard.ps1 runs it first, and this flow
#   also tries to generate it when missing).
#
# Output: generate_bitstream/guard_board_top.sbit (copied from
#   prj_tasks/pnr_1/generate_bitstream/ at the end of the flow)
#
# NOTE: keep this file ASCII-only. PDS/cdt Tcl interpreters read scripts with
# the system codepage; UTF-8 comments can swallow the following newline and
# silently merge the next command into the comment.
# ---------------------------------------------------------------------------
set here [file dirname [file normalize [info script]]]
set root [file normalize [file join $here ".." ".."]]

puts "guard-pds: root $root"
cd $root

# --- keyword package: generate it when missing (needs python on PATH) ---
set kw_pkg [file join $root "build" "gen" "l1_keywords_pkg.sv"]
if {![file exists $kw_pkg]} {
    file mkdir [file join $root "build" "gen"]
    puts "guard-pds: generating $kw_pkg"
    if {[catch {exec python [file join $root "tools" "gen_keywords.py"] $kw_pkg} err]} {
        error "cannot generate $kw_pkg ($err); run 'python tools/gen_keywords.py build/gen/l1_keywords_pkg.sv' first"
    }
}

set_arch -family Logos2 -device PG2L200H -package FBB676 -speedgrade -6

add_constraint [file join $here "guard_board.fdc"]

# --- RTL: L1 rule layer + board UART bridge (no vendor/, no DPI models) ---
# guard_pll.v is the PDS wrapper (real GTP_GPLL). Simulation uses
# guard_pll_sim.sv instead, which is NOT listed here.
set files [list \
    build/gen/l1_keywords_pkg.sv \
    build/gen/l2_weights_pkg.sv \
    build/gen/l2_entity_tables.sv \
    vendor/minitensor/rtl/tensor/tensor_pkg.sv \
    vendor/minitensor/rtl/tensor/MXU/Systolic_Array/tensor_pe.sv \
    vendor/minitensor/rtl/tensor/MXU/Systolic_Array/tensor_systolic_array.sv \
    vendor/minitensor/rtl/tensor/MXU/INT8_GEMM/tensor_gemm_core.sv \
    rtl/l1/l1_digit_engine.sv \
    rtl/l1/l1_text_engines.sv \
    rtl/l1/l1_keyword_match.sv \
    rtl/l1/l1_engine.sv \
    rtl/l1/l1_redact.sv \
    rtl/l2/l2_features.sv \
    rtl/l2/l2_int4_gemm.sv \
    rtl/l2/l2_semantic_top.sv \
    rtl/l2/l2_entity.sv \
    build/gen/l2_ner_cfg.sv \
    build/gen/l2_ner_rom.sv \
    build/gen/l2_ner_vocab.sv \
    rtl/l2/l2_ner.sv \
    rtl/board/guard_uart_baud.sv \
    rtl/board/guard_uart_rx.sv \
    rtl/board/guard_uart_tx.sv \
    rtl/board/guard_fifo.sv \
    rtl/board/guard_report.sv \
    rtl/board/guard_uart_core.sv \
    rtl/board/guard_pll.v \
    rtl/board/guard_board_top.sv]

foreach f $files {
    add_design [file join $root $f]
}

# PDS 2025.2: -verilog_standard SystemVerilog
# PDS 2022.2: -system_verilog  (set env PDS_VERILOG_STD=2022)
if {[info exists ::env(PDS_VERILOG_STD)] && $::env(PDS_VERILOG_STD) eq "2022"} {
    compile -top_module {guard_board_top} -system_verilog
} else {
    compile -top_module {guard_board_top} -verilog_standard SystemVerilog
}

synthesize -ads
dev_map
pnr -seed 2
report_timing -max_path 20
report_power
gen_bit_stream -create_bit true

# Copy the bitstream to a stable path (PDS writes it under prj_tasks/).
set sbit [file join $root "prj_tasks" "pnr_1" "generate_bitstream" "guard_board_top.sbit"]
if {[file exists $sbit]} {
    file mkdir [file join $root "generate_bitstream"]
    file copy -force $sbit [file join $root "generate_bitstream" "guard_board_top.sbit"]
    puts "guard-pds: bitstream -> generate_bitstream/guard_board_top.sbit"
} else {
    puts "guard-pds: WARNING bitstream not found at $sbit"
}

puts {=== GUARD_BUILD_DONE ===}