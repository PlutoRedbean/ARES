# =============================================================================
# guard_board.fdc —— 盘古 200Pro+（PG2L200H-6IFBB676）板级引脚/时钟约束
# 顶层：guard_board_top（串口进 → L1 脱敏 → 串口出）
#
#   clk_27m   D18   27 MHz 板载晶振（进 PLL）
#   rst_n     C22   低有效复位
#   uart_rx   B24   USB-UART 接收（ARES 的 MSH/RTOS 顶层用过这个脚；
#                   CoreMark 顶层把它 tie 成 1，所以之前没有约束）
#   uart_tx   C24   USB-UART 发送，115200 8N1
#   led[7:0]  A20 C18 C19 E18 A17 A18 C17 B17
#
# 时钟：27 MHz → GTP_GPLL（guard_pll）→ 10 MHz 核心时钟。
#   VCO = 27 MHz × 2 × 18.5185 = 1000 MHz，CLKOUT0 = 1000 / 100.0 = 10 MHz。
#   全部逻辑都在 core_clk 上；clk_27m 只进 PLL。
# =============================================================================

create_clock -name sys_clk -period 37.037 -waveform {0.000 18.5185} [get_ports {clk_27m}]

create_generated_clock -name core_clk -source [get_ports {clk_27m}] \
    [get_pins {u_pll/u_gpll/CLKOUT0}] -multiply_by 10 -divide_by 27

set_clock_uncertainty 0.300 -from [get_clocks {core_clk}] -to [get_clocks {core_clk}]

# 复位是异步输入（内部有复位同步器），不参与 setup
set_false_path -from [get_ports {rst_n}]
# UART RX 是异步串行输入，guard_uart_rx 里先过两级同步再采样
set_false_path -from [get_ports {uart_rx}]

# 输出端给个宽松的板级延迟（10 MHz，100 ns 周期，5 ns 足够）
set_output_delay -clock [get_clocks {core_clk}] 5.000 [get_ports {uart_tx}]
set_output_delay -clock [get_clocks {core_clk}] 5.000 [get_ports {led[*]}]

# ---------------------------------------------------------------------------
# 板级引脚
# ---------------------------------------------------------------------------
define_attribute {p:clk_27m} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:clk_27m} {PAP_IO_LOC} {D18}
define_attribute {p:clk_27m} {PAP_IO_VCCIO} {3.3}
define_attribute {p:clk_27m} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:clk_27m} {PAP_IO_NONE} {TRUE}

define_attribute {p:rst_n} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:rst_n} {PAP_IO_LOC} {C22}
define_attribute {p:rst_n} {PAP_IO_VCCIO} {3.3}
define_attribute {p:rst_n} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:rst_n} {PAP_IO_NONE} {TRUE}

define_attribute {p:uart_rx} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:uart_rx} {PAP_IO_LOC} {B24}
define_attribute {p:uart_rx} {PAP_IO_VCCIO} {3.3}
define_attribute {p:uart_rx} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:uart_rx} {PAP_IO_NONE} {TRUE}

define_attribute {p:uart_tx} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:uart_tx} {PAP_IO_LOC} {C24}
define_attribute {p:uart_tx} {PAP_IO_VCCIO} {3.3}
define_attribute {p:uart_tx} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:uart_tx} {PAP_IO_DRIVE} {8}
define_attribute {p:uart_tx} {PAP_IO_SLEW} {SLOW}
define_attribute {p:uart_tx} {PAP_IO_NONE} {TRUE}

# LED：0=收到字节 1=发出字节 2=出错(粘滞) 3=帧未结束 4=命中 span 7:5=0
define_attribute {p:led[0]} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:led[0]} {PAP_IO_LOC} {A20}
define_attribute {p:led[0]} {PAP_IO_VCCIO} {3.3}
define_attribute {p:led[0]} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:led[0]} {PAP_IO_DRIVE} {8}
define_attribute {p:led[0]} {PAP_IO_SLEW} {SLOW}
define_attribute {p:led[0]} {PAP_IO_NONE} {TRUE}

define_attribute {p:led[1]} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:led[1]} {PAP_IO_LOC} {C18}
