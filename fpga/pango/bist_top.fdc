# =============================================================================
# bist_top.fdc - board pins + PLL constraints for the standalone DDR3 BIST
#
# Target: Pangu 200Pro+ / PG2L200H-6IFBB676 (FBB676, -6)
#
# DDR3 pins / ref_clk / PHY clocks / PHY placement are in
# ip/ddr3/ddr3_ip.fdc.  Add that file FIRST, then this one, so ddrphy_sysclk
# exists when this file's asynchronous clock group is processed.
#
# Board pins: clk_27m D18, rst_n C22, uart_tx C24, led[7:0].
# No camera / HDMI pins in this top.
# =============================================================================

create_clock -name sys_clk -period 37.037 -waveform {0.000 18.5185} [get_ports {clk_27m}]

create_generated_clock -name pix_clk -source [get_ports {clk_27m}] \
    [get_pins {u_clk_reset/u_pll/u_gpll/CLKOUT0}] -multiply_by 11 -divide_by 8
create_generated_clock -name cfg_clk -source [get_ports {clk_27m}] \
    [get_pins {u_clk_reset/u_pll/u_gpll/CLKOUT1}] -multiply_by 10 -divide_by 27
create_generated_clock -name cam_clk -source [get_ports {clk_27m}] \
    [get_pins {u_clk_reset/u_pll/u_gpll/CLKOUT2}] -multiply_by 11 -divide_by 12

set_clock_uncertainty 0.300 -from [get_clocks {sys_clk}] -to [get_clocks {sys_clk}]

# ddrphy_sysclk is created by ddr3_ip.fdc; the BIST result 2FF is a CDC.
set_clock_groups -asynchronous \
    -group [get_clocks {sys_clk}] \
    -group [get_clocks {pix_clk}] \
    -group [get_clocks {cfg_clk}] \
    -group [get_clocks {cam_clk}] \
    -group [get_clocks {ddrphy_sysclk}]

set_false_path -from [get_ports {rst_n}]

# ---------------------------------------------------------------------------
# Board pins
# ---------------------------------------------------------------------------
define_attribute {p:clk_27m} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:clk_27m} {PAP_IO_LOC} {D18}
define_attribute {p:clk_27m} {PAP_IO_VCCIO} {3.3}
define_attribute {p:clk_27m} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:clk_27m} {PAP_IO_NONE} {TRUE}

define_attribute {p:rst_n} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:rst_n} {PAP_IO_LOC} {C22}
define_attribute {p:rst_n} {PAP_IO_VCCIO} {3.3}
define_attribute {p:rst_n} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:rst_n} {PAP_IO_NONE} {TRUE}

define_attribute {p:uart_tx} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:uart_tx} {PAP_IO_LOC} {C24}
define_attribute {p:uart_tx} {PAP_IO_VCCIO} {3.3}
define_attribute {p:uart_tx} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:uart_tx} {PAP_IO_DRIVE} {8}
define_attribute {p:uart_tx} {PAP_IO_SLEW} {SLOW}
define_attribute {p:uart_tx} {PAP_IO_NONE} {TRUE}

define_attribute {p:led[7]} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:led[7]} {PAP_IO_LOC} {B17}
define_attribute {p:led[7]} {PAP_IO_VCCIO} {3.3}
