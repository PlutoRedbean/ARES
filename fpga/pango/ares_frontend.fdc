# ---------------------------------------------------------------------------
# frontend-only constraints (BPU + IFU + ICache, no Backend/LSU).
#
# Used only to look at resources and a first timing estimate for the frontend
# in isolation.  Boundary ports carry no input/output delay (they are internal
# chip paths in the real SoC), so paths starting at ports are optimistic; the
# register-to-register paths are the meaningful ones.
# ---------------------------------------------------------------------------

create_clock -name sys_clk -period 10.000 -waveform {0.000 5.000} [get_ports {clk}]
set_clock_uncertainty 0.300 -from [get_clocks {sys_clk}] -to [get_clocks {sys_clk}]
set_false_path -from [get_ports {rst}]
