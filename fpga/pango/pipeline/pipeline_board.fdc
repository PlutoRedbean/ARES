# =============================================================================
# pipeline_board.fdc - Pango PG2L200H pin/clock constraints for the single-issue
# pipeline SoC (pipeline_board_top)
#
# Board: Pangu 200Pro+ / PG2L200H-6IFBB676 (FBB676, -6)
#   clk_27m  D18   27 MHz system clock
#   rst_n    C22   active-low board reset
#   uart_tx  C24   115200 8N1
#   led[7:0] A20 C18 C19 E18 A17 A18 C17 B17
#
# The UART RX pin is not defined by the existing board profile; the board top
# ties RX idle.  CoreMark scoring only needs TX.
#
# PLL: 27 MHz -> 100 MHz CPU / 50 MHz peripheral
#   VCO = 27 * 2 * 18.5185 = 1000 MHz
#   CPU    = 1000 / 10 = 100 MHz
#   PERIPH = 1000 / 20 =  50 MHz
# The generated-clock instance paths must match pipeline_clk_reset/pipeline_pll.
# =============================================================================

create_clock -name sys_clk -period 37.037 -waveform {0.000 18.5185} [get_ports {clk_27m}]

create_generated_clock -name cpu_clk -source [get_ports {clk_27m}] \
    [get_pins {u_clk_reset/u_pll/u_gpll/CLKOUT0}] -multiply_by 100 -divide_by 27
create_generated_clock -name periph_clk -source [get_ports {clk_27m}] \
    [get_pins {u_clk_reset/u_pll/u_gpll/CLKOUT1}] -multiply_by 50 -divide_by 27

set_clock_uncertainty 0.300 -from [get_clocks {sys_clk}] -to [get_clocks {sys_clk}]

# The two SoC domains are related in the PLL but cross through explicit CDC
# synchronizers.  Treat them as asynchronous for timing, as the video flow does.
set_clock_groups -asynchronous \
    -group [get_clocks {sys_clk}] \
    -group [get_clocks {cpu_clk}] \
    -group [get_clocks {periph_clk}]

set_false_path -from [get_ports {rst_n}]

# ---------------------------------------------------------------------------
# Board pins
# ---------------------------------------------------------------------------
define_attribute {p:clk_27m} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:clk_27m} {PAP_IO_LOC} {D18}
define_attribute {p:clk_27m} {PAP_IO_VCCIO} {3.3}
define_attribute {p:clk_27m} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:clk_27m} {PAP_IO_NONE} {TRUE}

define_attribute {p:rst_n} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:rst_n} {PAP_IO_LOC} {C22}
define_attribute {p:rst_n} {PAP_IO_VCCIO} {3.3}
define_attribute {p:rst_n} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:rst_n} {PAP_IO_NONE} {TRUE}

define_attribute {p:uart_tx} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:uart_tx} {PAP_IO_LOC} {C24}
define_attribute {p:uart_tx} {PAP_IO_VCCIO} {3.3}
define_attribute {p:uart_tx} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:uart_tx} {PAP_IO_DRIVE} {8}
define_attribute {p:uart_tx} {PAP_IO_SLEW} {SLOW}
define_attribute {p:uart_tx} {PAP_IO_NONE} {TRUE}

define_attribute {p:led[7]} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:led[7]} {PAP_IO_LOC} {B17}
define_attribute {p:led[7]} {PAP_IO_VCCIO} {3.3}
define_attribute {p:led[7]} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:led[7]} {PAP_IO_DRIVE} {8}
define_attribute {p:led[7]} {PAP_IO_SLEW} {SLOW}
define_attribute {p:led[7]} {PAP_IO_NONE} {TRUE}

define_attribute {p:led[6]} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:led[6]} {PAP_IO_LOC} {C17}
define_attribute {p:led[6]} {PAP_IO_VCCIO} {3.3}
define_attribute {p:led[6]} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:led[6]} {PAP_IO_DRIVE} {8}
define_attribute {p:led[6]} {PAP_IO_SLEW} {SLOW}
define_attribute {p:led[6]} {PAP_IO_NONE} {TRUE}

define_attribute {p:led[5]} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:led[5]} {PAP_IO_LOC} {A18}
define_attribute {p:led[5]} {PAP_IO_VCCIO} {3.3}
define_attribute {p:led[5]} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:led[5]} {PAP_IO_DRIVE} {8}
define_attribute {p:led[5]} {PAP_IO_SLEW} {SLOW}
