# ------------------------------------------------------------- camera side
# OV5640 CMOS1 constraints from the PG2L200H video board profile.
create_clock -name cmos1_pclk -period 11.905 [get_ports {cmos1_pclk}]
# camera_rstn is a quasi-static asynchronous reset generated by power_on_delay
# in the 27 MHz sys_clk domain and sampled by the ~25 MHz SCCB clock domain.
# It is held low for many milliseconds; do not let the reset deassertion path
# constrain the SCCB divider.  (If camera init ever proves flaky, add a 2FF
# reset synchronizer in reg_config instead.)
set_false_path -from [get_ports {cmos1_scl cmos1_sda}]

