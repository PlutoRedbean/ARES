# -------------------------------------------------------------- video PLL
create_generated_clock -name pix_clk -source [get_ports {clk_27m}] \
    [get_pins {u_video_clk_reset/u_pll/u_gpll/CLKOUT0}] -multiply_by 11 -divide_by 8
create_generated_clock -name cfg_clk -source [get_ports {clk_27m}] \
    [get_pins {u_video_clk_reset/u_pll/u_gpll/CLKOUT1}] -multiply_by 10 -divide_by 27
create_generated_clock -name cam_clk -source [get_ports {clk_27m}] \
    [get_pins {u_video_clk_reset/u_pll/u_gpll/CLKOUT2}] -multiply_by 11 -divide_by 12

