    int
    default 1  if STORE_BUFFER_DEPTH_1
    default 2  if STORE_BUFFER_DEPTH_2
    default 4  if STORE_BUFFER_DEPTH_4
    default 8  if STORE_BUFFER_DEPTH_8
    default 16 if STORE_BUFFER_DEPTH_16

endmenu # "Store Buffer"

endmenu # "CACHE"

menu "CSR"

config HAS_CSR_MSCRATCH
  bool "Enable CSR mscratch"
  default n

config HAS_CSR_MIE
  bool "Enable CSR mie"
  default y

config HAS_CSR_MIP
  bool "Enable CSR mip"
  default y

config HAS_CSR_MCYCLE
  bool "Enable CSRs mcycle and mcycleh"
  default y
  help
    Enable the 64-bit machine cycle counter exposed as mcycle/mcycleh on RV32.

config HAS_CSR_MISA
  bool "Enable CSR misa"
  default n

endmenu # "CSR"

menu "Custom Instruction Hardware"

config CUSTOM_CRC16
    bool "Enable CRC16 custom instruction"
    default y
    help
      Enable the Mundus custom-0 CRC16 instruction and its parallel CRC
      datapath. Disable this option to remove the CRC datapath and decoder
      entry from the generated hardware.

config CUSTOM_MULBE
    bool "Enable MULBE custom instruction"
    default y
    help
      Enable the Mundus custom-0 MULBE instruction and its CoreMark matrix
      bit-extract post-processing datapath. Disable this option to remove the
      MULBE decoder entry and post-processing hardware.

endmenu # "Custom Instruction Hardware"

config MUL_LATENCY
    int "Multiplier Latency"
    default 4

config DIV_LATENCY
    int "Divider Latency"
    default 35

endmenu # "Mundus Settings"
