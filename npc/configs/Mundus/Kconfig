menu "Mundus Settings"

config RVE
  bool "Enable RISC-V E"
  default y

menu "Branch Predict"

choice
    prompt "Select branch predictor"
    default BP_ALWAYS_NOT_TAKEN
    config BP_ALWAYS_NOT_TAKEN
        bool "Always Not Taken"
    config BP_BIMODAL
        bool "Bimodal Branch Predictor"
    config BP_TAGE
        bool "TAGE Branch Predictor"
endchoice

config BRANCH_PREDICT
    int
    default 0 if BP_ALWAYS_NOT_TAKEN
    default 1 if BP_BIMODAL
    default 2 if BP_TAGE

menu "Bimodal base and BTB parameters"
    depends on BP_BIMODAL || BP_TAGE

config BRANCH_BTB_WIDTH
    int "Branch target buffer index width"
    default 4
    range 1 16

config BRANCH_BIMODAL_BITS
    int "Bimodal base counter bits"
    default 2
    range 2 2

endmenu # "Bimodal base and BTB parameters"

menu "TAGE parameters"
    visible if BP_TAGE

config BRANCH_TAGE_TABLES
    int "Number of tagged tables" if BP_TAGE
    default 4
    range 4 4

config BRANCH_TAGE_INDEX_BITS
    int "Tagged table index width" if BP_TAGE
    default 8
    range 6 10

config BRANCH_TAGE_TAG_BITS
    int "Tagged table tag width" if BP_TAGE
    default 8
    range 6 12

config BRANCH_TAGE_CTR_BITS
    int "Prediction counter width" if BP_TAGE
    default 3
    range 3 3

config BRANCH_TAGE_USEFUL_BITS
    int "Usefulness counter width" if BP_TAGE
    default 2
    range 2 2

config BRANCH_TAGE_HIST_0
    int "Table 0 history length" if BP_TAGE
    default 4
    range 1 64

config BRANCH_TAGE_HIST_1
    int "Table 1 history length" if BP_TAGE
    default 12
    range 1 64

config BRANCH_TAGE_HIST_2
    int "Table 2 history length" if BP_TAGE
    default 32
    range 1 64

config BRANCH_TAGE_HIST_3
    int "Table 3 history length" if BP_TAGE
    default 64
    range 1 64

config BRANCH_FTQ_DEPTH
    int "Fetch target queue entries" if BP_TAGE
    default 8
    range 2 16
    help
      Number of fetch-block checkpoints retained by the TAGE frontend.  The
      FTQ is a sideband bookkeeping queue and is not placed in the fast
      Bimodal-to-next-PC path.

endmenu # "TAGE parameters"

menu "Fast recurrence predictor parameters"
    depends on BP_BIMODAL || BP_TAGE

config BRANCH_FAST_RECURRENCE
    bool "Enable fast CRC recurrence predictor"
    default n
    help
      Recognize the adjacent ANDI-bit-test and conditional branch idiom used
      by bit-serial CRC code. A small per-PC table learns the recurrence and
      supplies direction beside Bimodal. Owned branches bypass TAGE so their
      data-dependent outcomes do not enter TAGE history or tagged tables.

config BRANCH_FAST_RECURRENCE_INDEX_BITS
    int "Predictor table index width" if BRANCH_FAST_RECURRENCE
    default 3
    range 1 5

endmenu # "Fast recurrence predictor parameters"

menu "Return Address Stack parameters"
    depends on BP_BIMODAL || BP_TAGE

config BRANCH_RAS
    bool "Enable Return Address Stack"
    default y
    help
      Predict JALR returns using a small hardware return-address stack.
      Return classification is stored in the synchronous BTB, so instruction
      decoding is not added to the fetch-PC combinational path.

config BRANCH_RAS_WIDTH
    int "Stack index width" if BRANCH_RAS
    default 3
    range 1 5

endmenu # "Return Address Stack parameters"

menu "Loop Predictor parameters"
    depends on BP_BIMODAL || BP_TAGE

config BRANCH_LOOP_PREDICTOR
    bool "Enable Loop Predictor"
    default n
    help
      Add a small loop predictor beside Bimodal.  It learns both conventional
      backward loop branches and forward loop-exit guards.  A confident table
      hit overrides only the direction prediction; the target still comes
      from the Bimodal BTB.

endmenu # "Loop Predictor parameters"

config BRANCH_TAGE
    bool
    default y if BP_TAGE

config BRANCH_DIRECTION_METADATA
    bool
    default y if BRANCH_LOOP_PREDICTOR || BP_TAGE || BRANCH_FAST_RECURRENCE

config BRANCH_DIRECTION_METADATA_ENABLE
    int
    default 1 if BRANCH_DIRECTION_METADATA
    default 0

config BRANCH_LOOP_PREDICTOR_ENABLE
    int
    default 1 if BRANCH_LOOP_PREDICTOR
    default 0

endmenu # "Branch Predict"

menu "Frontend"

choice
    prompt "Instruction ROM capacity"
    default IROM_SIZE_32KB
    help
      Select the JYD instruction ROM capacity.  The generated C, Verilog and
      Scala configuration, the Verilator memory model, and image packing tools
      all derive their limits and address widths from this selection.

config IROM_SIZE_16KB
    bool "16 KiB"

config IROM_SIZE_32KB
    bool "32 KiB"

endchoice

config IROM_SIZE_KB
    int
    default 16 if IROM_SIZE_16KB
    default 32 if IROM_SIZE_32KB

config IROM_SIZE_BYTES
    int
    default 16384 if IROM_SIZE_16KB
    default 32768 if IROM_SIZE_32KB

config IROM_DEPTH
    int
    default 2048 if IROM_SIZE_16KB
    default 4096 if IROM_SIZE_32KB
    help
      Number of 64-bit entries in the instruction ROM.

config IROM_ADDR_WIDTH
    int
    default 11 if IROM_SIZE_16KB
    default 12 if IROM_SIZE_32KB
    help
      Address width for the 64-bit instruction ROM interface.

config FRONTEND_QUEUE
    bool "Enable fall-through instruction buffer"
    default y
    help
      Use an asynchronous-read instruction buffer between IROM and IF/ID.
      An empty buffer forwards the IROM response directly, so enabling it does
      not add a pipeline stage to the normal fetch path.  While the backend is
      stalled, fetching continues until the buffer and in-flight response fill.

config FRONTEND_QUEUE_DEPTH
    int "Instruction buffer depth" if FRONTEND_QUEUE
    default 8
    range 4 16
    help
      Number of entries in the dual-fetch instruction queue.

config IROM_CORE_OUTPUT_REGISTER
    bool
    default n
    help
      Keep the Block Memory Generator core output register disabled.  TAGE
      uses an FTQ-backed late correction and therefore does not extend the
      one-cycle instruction-ROM response.

config IROM_READ_LATENCY
    int
    default 1

endmenu # "Frontend"

menu "CACHE"

