    config ICACHE_WAY_2
        bool "2  Ways"
    config ICACHE_WAY_4
        bool "4  Ways"
    config ICACHE_WAY_8
        bool "8  Ways"
    config ICACHE_WAY_16
        bool "16 Ways"
    config ICACHE_WAY_32
        bool "32 Ways"
endchoice

config ICACHE_WAY
    int
    default 1  if ICACHE_WAY_1
    default 2  if ICACHE_WAY_2
    default 4  if ICACHE_WAY_4
    default 8  if ICACHE_WAY_8
    default 16 if ICACHE_WAY_16
    default 32 if ICACHE_WAY_32

config ICACHE_WAY_WIDTH
    int
    default 0 if ICACHE_WAY_1
    default 1 if ICACHE_WAY_2
    default 2 if ICACHE_WAY_4
    default 3 if ICACHE_WAY_8
    default 4 if ICACHE_WAY_16
    default 5 if ICACHE_WAY_32

endmenu # "ICACHE"

menu "DCACHE"

config LSU_EX2_STORE_REPLAY
    bool "Replay speculative loads on Ex2 store conflicts"
    default n
    help
      Launch cacheable load lookups before older in-flight store addresses are
      checked.  A matching store detected from registered Ex2 metadata holds
      the load locally and replays its cache lookup after older stores drain.

choice
    prompt "Select D-cache size"
    default DCACHE_SIZE_8KB
    help
      Select the data capacity of the direct-mapped D-cache. Each cache entry
      contains one 32-bit word. The DCacheData_BRAM depth and DCacheTag_BRAM
      port widths must be updated to match this setting in the Vivado project.

    config DCACHE_SIZE_1KB
        bool "1 KiB"
    config DCACHE_SIZE_2KB
        bool "2 KiB"
    config DCACHE_SIZE_4KB
        bool "4 KiB"
    config DCACHE_SIZE_8KB
        bool "8 KiB"
    config DCACHE_SIZE_16KB
        bool "16 KiB"
    config DCACHE_SIZE_32KB
        bool "32 KiB"
    config DCACHE_SIZE_64KB
        bool "64 KiB"
endchoice

config DCACHE_SIZE_KB
    int
    default 1  if DCACHE_SIZE_1KB
    default 2  if DCACHE_SIZE_2KB
    default 4  if DCACHE_SIZE_4KB
    default 8  if DCACHE_SIZE_8KB
    default 16 if DCACHE_SIZE_16KB
    default 32 if DCACHE_SIZE_32KB
    default 64 if DCACHE_SIZE_64KB

endmenu # "DCACHE"

