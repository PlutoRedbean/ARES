diff --git a/gcc/config/riscv/mundus.md b/gcc/config/riscv/mundus.md
new file mode 100644
index 00000000..02a267e4
--- /dev/null
+++ b/gcc/config/riscv/mundus.md
@@ -0,0 +1,56 @@
+;; Pipeline description for the Mundus in-order asymmetric two-wide core.
+
+(define_automaton "mundus")
+
+;; Slot 0 accepts integer ALU, multiply, and memory operations.  Slot 1 accepts
+;; the same classes plus control flow.  The LSU is shared by both slots.
+(define_cpu_unit "mundus_slot0,mundus_slot1,mundus_mem,mundus_div" "mundus")
+
+(define_insn_reservation "mundus_alu" 1
+  (and (eq_attr "tune" "mundus")
+       (eq_attr "type" "unknown,const,arith,shift,slt,multi,auipc,nop,logical,\
+			move,bitmanip,min,max,minu,maxu,clz,ctz,rotate,condmove,\
+			crypto,mvpair,zicond"))
+  "mundus_slot0|mundus_slot1")
+
+(define_insn_reservation "mundus_load" 3
+  (and (eq_attr "tune" "mundus")
+       (eq_attr "type" "load,fpload"))
+  "(mundus_slot0|mundus_slot1)+mundus_mem")
+
+(define_insn_reservation "mundus_store" 1
+  (and (eq_attr "tune" "mundus")
+       (eq_attr "type" "store,fpstore"))
+  "(mundus_slot0|mundus_slot1)+mundus_mem")
+
+;; Control flow is legal only as the younger instruction in slot 1.  The
+;; variable-issue hook ends the cycle if one is selected first.
+(define_insn_reservation "mundus_control" 1
+  (and (eq_attr "tune" "mundus")
+       (eq_attr "type" "branch,jump,call,jalr,ret"))
+  "mundus_slot1")
+
+(define_insn_reservation "mundus_mul" 4
+  (and (eq_attr "tune" "mundus")
+       (eq_attr "type" "imul,clmul,cpop"))
+  "mundus_slot0|mundus_slot1")
+
+;; Divide and system-like instructions are scalar.  The iterative divider can
+;; accept no second divide until its fixed 35-cycle operation completes.
+(define_insn_reservation "mundus_div" 35
+  (and (eq_attr "tune" "mundus")
+       (eq_attr "type" "idiv"))
+  "mundus_slot0+mundus_slot1+mundus_div,mundus_div*34")
+
+(define_insn_reservation "mundus_system" 1
+  (and (eq_attr "tune" "mundus")
+       (eq_attr "type" "trap,atomic,mtc,mfc,fcvt,fcvt_i2f,fcvt_f2i,fmove,\
+			rdfrm,wrfrm,wrvxrm"))
+  "mundus_slot0+mundus_slot1")
+
+;; These are not generated for rv32im, but keeping a conservative scalar
+;; reservation makes -mtune=mundus robust when GCC emits an auxiliary class.
+(define_insn_reservation "mundus_aux" 4
+  (and (eq_attr "tune" "mundus")
+       (eq_attr "type" "sfb_alu,fadd,fmul,fmadd,fdiv,fcmp,fsqrt"))
+  "mundus_slot0+mundus_slot1")
